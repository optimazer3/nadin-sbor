# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Telegram ID руководителя (можно несколько через запятую).
# Пока не знаете свой ID — оставьте 0, запустите бота и напишите ему /start:
# он ответит вашим ID. Впишите его сюда и перезапустите бота.
ADMIN_IDS=0

# --- Supabase ---
# Project URL: Project Settings -> Data API (вида https://abcdefgh.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Секретный ключ: Project Settings -> API Keys ->
#   вкладка «Legacy API Keys» -> service_role -> Reveal (начинается с eyJ...)
#   или вкладка «API Keys» -> Secret keys (начинается с sb_secret_...)
# НЕ anon и НЕ publishable. Ключ даёт полный доступ к базе — никому не пересылайте.
SUPABASE_KEY=your-service-role-key

# --- AssemblyAI (распознавание речи) ---
ASSEMBLYAI_API_KEY=your-assemblyai-key
# Для EU-региона: https://api.eu.assemblyai.com
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_LANGUAGE=ru
# Модель распознавания; оставьте пустым, чтобы AssemblyAI выбрал модель по умолчанию
ASSEMBLYAI_SPEECH_MODEL=

# --- Нейросеть для разбора текста в задачу (Polza AI, OpenAI-совместимый API) ---
# Ключ из личного кабинета Polza AI
LLM_API_KEY=your-polza-api-key
# Адрес API. Сверьте в документации Polza (раздел про OpenAI-совместимый API)
LLM_BASE_URL=https://api.polza.ai/api/v1
# ID модели — скопируйте точно так, как он написан в каталоге моделей Polza
LLM_MODEL=openai/gpt-4.1-mini

# --- Команда ---
# Имена сотрудников через запятую. Нужны, чтобы бот понимал «Ване» -> «Иван»
# и показывал кнопки выбора исполнителя. Можно оставить пустым.
TEAM_MEMBERS=Иван,Мария,Алексей

# --- Еженедельное напоминание ---
TIMEZONE=Europe/Moscow
# День недели: mon, tue, wed, thu, fri, sat, sun
REMINDER_DAY=mon
REMINDER_TIME=10:00
