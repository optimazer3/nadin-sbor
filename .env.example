# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-telegram-bot-token
# Telegram ID руководителя (можно несколько через запятую).
# Узнать свой ID: запустите бота и напишите ему /start — он ответит вашим ID.
ADMIN_IDS=123456789

# --- Supabase ---
# Project Settings -> API: Project URL и ключ service_role (secret).
# Ключ service_role даёт полный доступ к базе — не публикуйте его.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- AssemblyAI (распознавание речи) ---
ASSEMBLYAI_API_KEY=your-assemblyai-key
# Для EU-региона: https://api.eu.assemblyai.com
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_LANGUAGE=ru
# Модель распознавания; оставьте пустым, чтобы AssemblyAI выбрал модель по умолчанию
ASSEMBLYAI_SPEECH_MODEL=

# --- Claude API (разбор текста в задачу) ---
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-opus-5-5

# --- Команда ---
# Имена сотрудников через запятую. Нужны, чтобы бот понимал «Ване» -> «Иван»
# и показывал кнопки выбора исполнителя. Можно оставить пустым.
TEAM_MEMBERS=Иван,Мария,Алексей

# --- Еженедельное напоминание ---
TIMEZONE=Europe/Moscow
# День недели: mon, tue, wed, thu, fri, sat, sun
REMINDER_DAY=mon
REMINDER_TIME=10:00
